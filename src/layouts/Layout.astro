---
import "../styles/global.css";
import type { Lang } from "../i18n";
import { t } from "../i18n";

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
}

const { lang = "en" } = Astro.props;
const T = t(lang);
const { title = T.title, description = T.description } = Astro.props;
const base = import.meta.env.BASE_URL;
const origin = Astro.site ?? Astro.url.origin;
const ogImage = new URL(`${base}og-image.png`, origin).toString();
const enUrl = new URL(base, origin).toString();
const deUrl = new URL(`${base}de/`, origin).toString();
---

<!doctype html>
<html lang={T.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === "de" ? "de_AT" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="bg-void text-slate-200 antialiased">
    <div class="crt-overlay"></div>
    <slot />
  </body>
</html>
