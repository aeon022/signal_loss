---
import Layout from "../layouts/Layout.astro";
import GameTerminal from "../components/GameTerminal.astro";
import FooterSignature from "../components/FooterSignature.astro";

const base = import.meta.env.BASE_URL;
const starfield = `${base}starfield.svg`;
---

<Layout title="Signal Loss — Sector Schrödinger">
  <header class="sticky top-0 z-50 border-b border-white/10 bg-void/80 px-4 py-3 backdrop-blur sm:px-6">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-4">
      <a href={base} id="header-logo" class="flex items-center gap-2 text-xs font-bold tracking-[0.2em] text-cyan-bright sm:text-sm">
        <span class="pulse-glow text-green">●</span>
        SIGNAL LOSS
        <span class="hidden font-normal tracking-normal text-dim sm:inline">// terminal distress beacon</span>
      </a>
      <nav class="flex items-center gap-3 text-xs tracking-widest text-dim sm:gap-5">
        <a href="https://github.com/aeon022/signal_loss" target="_blank" rel="noopener noreferrer" class="hover:text-cyan">GITHUB</a>
        <a href="https://buy.polar.sh/polar_cl_CbYo27mWKgPdiEv3IJS680uCrzqDus7LWzd131V74y0" target="_blank" rel="noopener noreferrer" class="hover:text-amber">SUPPORT</a>
        <a href="https://abteilung83.at/imprint" target="_blank" rel="noopener noreferrer" class="hidden hover:text-cyan sm:inline">IMPRESSUM</a>
        <a href="https://abteilung83.at/contact" target="_blank" rel="noopener noreferrer" class="hidden hover:text-cyan sm:inline">KONTAKT</a>
      </nav>
    </div>
  </header>

  <div class="overflow-hidden border-b border-white/5 bg-black/40 py-1.5 text-[10px] tracking-[0.15em] text-amber/70">
    <div class="ticker-track">
      <span class="px-4">HULL INTEGRITY: 61% · O2 RESERVE: 340 CYCLES · S.T.E.V.E. MOOD: RESIGNED · SECTOR: SCHRÖDINGER · SIGNAL: LOST · COORDINATES: UNKNOWN · BATTERY: 12% AND FALLING ·</span>
      <span class="px-4">HULL INTEGRITY: 61% · O2 RESERVE: 340 CYCLES · S.T.E.V.E. MOOD: RESIGNED · SECTOR: SCHRÖDINGER · SIGNAL: LOST · COORDINATES: UNKNOWN · BATTERY: 12% AND FALLING ·</span>
    </div>
  </div>

  <main class="relative">
    <div class="grid-backdrop" style={`background-image: url("${starfield}"), url("${starfield}");`}></div>

    <section class="relative mx-auto flex min-h-[75vh] max-w-4xl flex-col items-center justify-center px-6 py-24 text-center">
      <div class="radar-ping"></div>
      <p class="relative z-10 mb-4 flex items-center gap-2 text-sm tracking-[0.3em] text-cyan crt-flicker">
        <span class="pulse-glow text-green">●</span>
        SECTOR SCHRÖDINGER · GRYPS-4
      </p>
      <h1 class="glow-chromatic relative z-10 text-6xl font-bold tracking-tight text-cyan-bright sm:text-8xl">
        SIGNAL LOSS
      </h1>
      <p class="relative z-10 mt-6 max-w-xl text-balance text-base text-slate-300">
        Your freighter just crash-landed on a cosmic dumping ground. Your ship's AI is sarcastic,
        anxious, and perpetually low on battery. Twelve chapters. Three endings. Most of your
        choices are worse than they sound.
      </p>
      <a
        href="#play"
        class="group relative z-10 mt-10 flex items-center gap-2 rounded-sm border border-cyan/50 px-6 py-3 text-sm tracking-widest text-cyan-bright transition hover:border-cyan hover:bg-cyan/10 hover:shadow-[0_0_25px_rgba(34,211,238,0.35)]"
      >
        &gt; ESTABLISH UPLINK
        <span class="transition group-hover:translate-x-1">↓</span>
      </a>
    </section>

    <div class="mx-auto h-px w-full max-w-3xl bg-gradient-to-r from-transparent via-cyan/30 to-transparent"></div>

    <section id="play" class="relative px-4 py-20">
      <GameTerminal />
    </section>

    <div class="hazard-stripe mx-auto max-w-3xl"></div>

    <section class="relative mx-auto max-w-4xl px-6 py-20 text-sm text-slate-300">
      <div class="grid gap-6 sm:grid-cols-3">
        <div class="corner-frame border border-white/10 bg-panel/60 p-5 text-amber">
          <span class="rivet-tr"></span><span class="rivet-bl"></span>
          <h2 class="glow-amber mb-2 text-xs tracking-widest">REAL BRANCHING</h2>
          <p class="text-slate-300">
            Every chapter but the finale has a choice that's a genuine dead end — instant death,
            or a setback that sends you back to the start with something lost.
          </p>
        </div>
        <div class="corner-frame border border-white/10 bg-panel/60 p-5 text-magenta">
          <span class="rivet-tr"></span><span class="rivet-bl"></span>
          <h2 class="glow-magenta mb-2 text-xs tracking-widest">LIVING CODEX</h2>
          <p class="text-slate-300">
            Press <kbd class="rounded border border-white/10 bg-white/10 px-1.5 py-0.5 text-xs text-slate-200">c</kbd>
            in-game for a lexicon of terms — but it only knows what the story has actually told you so far.
          </p>
        </div>
        <div class="corner-frame border border-white/10 bg-panel/60 p-5 text-green">
          <span class="rivet-tr"></span><span class="rivet-bl"></span>
          <h2 class="glow-green mb-2 text-xs tracking-widest">RUNS IN YOUR BROWSER</h2>
          <p class="text-slate-300">
            The exact same Go engine as the terminal version, compiled to WebAssembly. No install,
            no server round-trips — it's playing locally, right here.
          </p>
        </div>
      </div>
    </section>

    <footer class="relative border-t border-white/10 px-6 py-10 text-center text-xs text-dim">
      <p>
        SIGNAL LOSS: SECTOR SCHRÖDINGER — built with Go,
        <a href="https://github.com/charmbracelet/bubbletea" target="_blank" rel="noopener noreferrer" class="underline decoration-dotted hover:text-cyan">Bubble Tea</a>,
        and Astro.
      </p>
      <p class="mt-2">
        <a href="https://github.com/aeon022/signal_loss" target="_blank" rel="noopener noreferrer" class="underline decoration-dotted hover:text-cyan">Source on GitHub</a>
        · prefer a real terminal?
      </p>
      <p class="mt-1 px-6">
        <code class="break-all text-slate-400">go install github.com/aeon022/signal_loss/cmd/signal_loss@v0.1.0</code>
      </p>
      <p class="mt-2">
        <a href="https://buy.polar.sh/polar_cl_CbYo27mWKgPdiEv3IJS680uCrzqDus7LWzd131V74y0" target="_blank" rel="noopener noreferrer" class="underline decoration-dotted hover:text-amber">Support this project ↗</a>
      </p>
      <p class="mt-6 text-dim/70">
        No tracking cookies, no analytics — your save file lives in this browser's localStorage
        and nothing else leaves your machine.
      </p>
      <p class="mt-2 text-dim/70">
        <a href="https://abteilung83.at/imprint" target="_blank" rel="noopener noreferrer" class="underline decoration-dotted hover:text-cyan">Impressum</a>
        · <a href="https://abteilung83.at/privacy" target="_blank" rel="noopener noreferrer" class="underline decoration-dotted hover:text-cyan">Datenschutz</a>
        · <a href="https://abteilung83.at/cookies" target="_blank" rel="noopener noreferrer" class="underline decoration-dotted hover:text-cyan">Cookies</a>
        · <a href="https://abteilung83.at/contact" target="_blank" rel="noopener noreferrer" class="underline decoration-dotted hover:text-cyan">Kontakt</a>
      </p>
      <p class="mt-6 text-[10px] tracking-widest text-dim/40">
        S.T.E.V.E.: this terminal still answers to a few old arcade protocols, for whoever still remembers them.
      </p>
    </footer>
    <FooterSignature />
  </main>

  <div
    id="cookie-notice"
    class="fixed inset-x-4 bottom-4 z-[70] mx-auto flex max-w-lg flex-col gap-3 rounded-sm border border-cyan/40 bg-black/95 px-5 py-4 text-xs text-slate-300 shadow-[0_0_30px_rgba(0,0,0,0.6)] sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="leading-relaxed">
      <span class="text-cyan-bright">◉ SYSTEM NOTICE —</span>
      this terminal stores your save file in this browser's <code class="text-slate-400">localStorage</code>.
      No cookies, no tracking, no third parties.
      <a href="https://abteilung83.at/cookies" target="_blank" rel="noopener noreferrer" class="underline decoration-dotted hover:text-cyan">Details</a>
    </p>
    <button
      id="cookie-ack"
      type="button"
      class="shrink-0 rounded-sm border border-cyan/50 px-4 py-2 text-xs tracking-widest text-cyan-bright transition hover:border-cyan hover:bg-cyan/10"
    >
      ACKNOWLEDGE
    </button>
  </div>

  <script>
    const COOKIE_KEY = "sl_cookie_ack";
    const notice = document.getElementById("cookie-notice")!;
    if (localStorage.getItem(COOKIE_KEY) === "1") {
      notice.remove();
    } else {
      document.getElementById("cookie-ack")!.addEventListener("click", () => {
        localStorage.setItem(COOKIE_KEY, "1");
        notice.remove();
      });
    }
  </script>

  <div
    id="konami-toast"
    class="pointer-events-none fixed inset-x-4 bottom-6 z-[60] mx-auto max-w-sm -translate-y-2 rounded-sm border border-green/50 bg-black/95 px-4 py-3 text-center text-xs tracking-widest text-green opacity-0 shadow-[0_0_25px_rgba(74,222,128,0.25)] transition-all duration-300"
  >
    S.T.E.V.E.: Nice. Doesn't do anything, but nice.
  </div>

  <script>
    // Konami code easter egg — up up down down left right left right b a.
    // No mechanic behind it, same spirit as the exit-screen quotes.
    console.log("%cS.T.E.V.E.: Some old arcade protocols still work on this terminal. ↑↑↓↓←→←→ba, if you remember them.", "color: #4ade80; font-family: monospace;");
    const KONAMI = ["ArrowUp","ArrowUp","ArrowDown","ArrowDown","ArrowLeft","ArrowRight","ArrowLeft","ArrowRight","b","a"];
    let progress = 0;
    document.addEventListener("keydown", (e) => {
      progress = e.key === KONAMI[progress] ? progress + 1 : (e.key === KONAMI[0] ? 1 : 0);
      if (progress === KONAMI.length) {
        progress = 0;
        const toast = document.getElementById("konami-toast")!;
        toast.style.opacity = "1";
        toast.style.transform = "translateY(0)";
        setTimeout(() => {
          toast.style.opacity = "0";
          toast.style.transform = "translateY(-0.5rem)";
        }, 3000);
      }
    });
  </script>
</Layout>
