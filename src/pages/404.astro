---
import Layout from "../layouts/Layout.astro";
import { t } from "../i18n";

// GitHub Pages serves this for every unknown URL under the site, whatever the language.
const T = t("en");
const D = t("de");
const base = import.meta.env.BASE_URL;
---

<Layout title={T.notFoundTitle}>
  <main class="mx-auto flex min-h-screen max-w-xl flex-col items-center justify-center gap-6 px-6 text-center">
    <h1 class="glow-chromatic text-5xl font-bold text-cyan-bright">404</h1>
    <p class="text-slate-300">{T.notFoundText}</p>
    <p class="text-slate-400">{D.notFoundText}</p>
    <a href={base} class="rounded-sm border border-cyan/50 px-6 py-3 text-sm tracking-widest text-cyan-bright transition hover:border-cyan hover:bg-cyan/10">{T.back}</a>
    <a href={`${base}de/`} class="text-xs tracking-widest text-dim hover:text-cyan">{D.back}</a>
  </main>
</Layout>
