---
// Boots the WASM build of the Go game (see /public/game/) into an xterm.js
// terminal — the exact same Bubble Tea engine as the CLI, bridged to the
// browser. Fixed size to match the game's own fixed-viewport design (it
// deliberately doesn't reflow — see signal_loss/pkg/tui).
import { t } from "../i18n";
import type { Lang } from "../i18n";

const { lang = "en" } = Astro.props as { lang?: Lang };
const G = t(lang).game;
const base = import.meta.env.BASE_URL;
const kbd = "rounded border border-white/10 bg-white/10 px-1 text-slate-300";
---

<div id="game-widget" class="mx-auto w-fit max-w-full" data-base={base} data-lang={lang} data-t={JSON.stringify(G)}>
  <div class="mb-2 flex items-center justify-between px-1 text-xs tracking-widest text-dim">
    <span>CSS RUST-404 // EMERGENCY TERMINAL LINK</span>
    <span id="game-status" class="text-amber">{G.status.standby}</span>
  </div>

  <!-- The terminal itself is a fixed 84-column widget (matches the game's
       own "monitor, doesn't reflow" design) — on screens narrower than
       that, it scrolls horizontally within this box instead of forcing
       the whole page wider than the viewport. -->
  <div class="relative max-w-full overflow-x-auto rounded-sm border border-cyan/40 bg-black p-3 shadow-[0_0_50px_rgba(94,234,212,0.14)]">
    <div id="terminal" class="w-fit"></div>

    <!-- Pre-launch config panel, overlaid on top of the (still empty)
         terminal. Removed once ESTABLISH UPLINK is pressed. -->
    <div
      id="launch-panel"
      class="absolute inset-3 flex flex-col items-center justify-center gap-5 overflow-y-auto bg-black/95 px-6 text-center"
    >
      <div class="glow-cyan text-sm tracking-[0.25em] text-cyan-bright">{G.launch}</div>

      <div class="w-full max-w-sm space-y-4">
        <div>
          <div class="mb-2 text-left text-[11px] tracking-widest text-dim">{G.language}</div>
          <div class="grid grid-cols-2 gap-2" data-group="lang">
            <button type="button" data-value="en" class="config-btn" aria-pressed={String(lang === "en")}>ENGLISH</button>
            <button type="button" data-value="de" class="config-btn" aria-pressed={String(lang === "de")}>DEUTSCH</button>
          </div>
        </div>

        <div>
          <div class="mb-2 text-left text-[11px] tracking-widest text-dim">{G.speed}</div>
          <div class="grid grid-cols-2 gap-2" data-group="speed">
            <button type="button" data-value="normal" class="config-btn" aria-pressed="true">{G.normal}</button>
            <button type="button" data-value="fast" class="config-btn">{G.fast}</button>
          </div>
        </div>

        <div>
          <div class="mb-2 text-left text-[11px] tracking-widest text-dim">{G.locks}</div>
          <div class="grid grid-cols-2 gap-2" data-group="mode">
            <button type="button" data-value="compressed" class="config-btn" aria-pressed="true">{G.compressed}</button>
            <button type="button" data-value="realtime" class="config-btn">{G.realtime}</button>
          </div>
          <p class="mt-2 text-left text-[11px] leading-relaxed text-dim" id="mode-hint">{G.hintCompressed}</p>
        </div>
      </div>

      <button
        id="launch-btn"
        type="button"
        class="mt-1 rounded-sm border border-cyan/50 px-8 py-3 text-sm tracking-widest text-cyan-bright transition hover:border-cyan hover:bg-cyan/10 hover:shadow-[0_0_25px_rgba(94,234,212,0.3)]"
      >
        {G.establish}
      </button>

      <div class="text-[11px] tracking-widest text-dim">
        <label class="cursor-pointer underline decoration-dotted hover:text-cyan">
          {G.import}<input id="import-file" type="file" accept=".json,application/json" class="hidden" />
        </label>
        <p id="import-msg" class="mt-1 h-4 normal-case tracking-normal"></p>
      </div>
    </div>

    <!-- Shown when the player quits in-game ([q]) or the WASM program exits
         for any other reason. Hidden until then. -->
    <div
      id="exit-panel"
      class="absolute inset-3 hidden flex-col items-center justify-center gap-5 bg-black/95 px-6 text-center"
    >
      <div class="glow-cyan text-sm tracking-[0.25em] text-red">{G.exitTitle}</div>
      <p id="exit-quote" class="max-w-sm text-sm italic text-slate-400"></p>
      <div id="share" class="hidden max-w-sm flex-col items-center gap-2 border border-white/10 px-4 py-3">
        <div class="text-[11px] tracking-widest text-dim">{G.shareTitle}</div>
        <p id="share-text" class="text-sm text-slate-200"></p>
        <button id="share-btn" type="button" class="config-btn">{G.shareCopy}</button>
      </div>
      <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
        <button
          id="reconnect-btn"
          type="button"
          class="rounded-sm border border-cyan/50 px-6 py-2.5 text-xs tracking-widest text-cyan-bright transition hover:border-cyan hover:bg-cyan/10 hover:shadow-[0_0_20px_rgba(94,234,212,0.3)]"
        >
          {G.reconnect}
        </button>
        <a
          href="https://github.com/aeon022/signal_loss"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-sm border border-white/20 px-6 py-2.5 text-xs tracking-widest text-slate-300 transition hover:border-white/40 hover:text-white"
        >
          {G.source}
        </a>
      </div>
    </div>
  </div>

  <div class="mt-2 flex flex-wrap items-center justify-between gap-2 px-1 text-xs text-dim">
    <p>{G.focus}</p>
    <div class="flex gap-2">
      <button id="sound-btn" type="button" class="config-btn" aria-pressed="false">{G.soundOff}</button>
      <button id="export-btn" type="button" class="config-btn">{G.exportSave}</button>
    </div>
  </div>
  <p class="mt-1 px-1 text-xs text-dim">
    {G.keys.map(([k, label], i) => (<><kbd class={kbd}>{k}</kbd> {label}{i < G.keys.length - 1 ? " · " : ""}</>))}
  </p>

  <!-- On-screen keys for phones and tablets (coarse pointer only). -->
  <div id="touchpad" class="touchpad mt-3 flex-wrap justify-center gap-2" aria-label={G.touch}>
    {[["1", "1"], ["2", "2"], ["3", "3"], ["4", "4"], ["↑", "\x1b[A"], ["↓", "\x1b[B"], ["⏎", "\r"], ["c", "c"], ["m", "m"], ["?", "?"], ["esc", "\x1b"]].map(([label, send]) => (
      <button type="button" class="config-btn touch-btn" data-send={send}>{label}</button>
    ))}
  </div>
</div>

<style>
  .touchpad { display: none; }
  @media (pointer: coarse) { .touchpad { display: flex; } }
  .touch-btn { min-width: 3rem; min-height: 2.75rem; font-size: 1rem; }
  .config-btn {
    border: 1px solid var(--color-dim);
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: #cbd5e1;
    background: transparent;
    transition: all 0.15s ease;
  }
  .config-btn:hover {
    border-color: var(--color-cyan);
    color: var(--color-cyan-bright);
  }
  .config-btn[aria-pressed="true"] {
    border-color: var(--color-cyan);
    color: var(--color-cyan-bright);
    background: color-mix(in oklab, var(--color-cyan) 14%, transparent);
    box-shadow: 0 0 14px color-mix(in oklab, var(--color-cyan) 40%, transparent);
  }
</style>

<!-- Classic (non-module) script: runs immediately at parse time, so window.Go
     exists before the deferred module script below needs it. It's a plain
     public/ asset (Go's own wasm_exec.js glue), not something to bundle. -->
<script src={`${base}game/wasm_exec.js`} is:inline></script>

<script>
  import { Terminal } from "@xterm/xterm";
  import "@xterm/xterm/css/xterm.css";

  // Must be >= the game's true rendered frame height or Bubble Tea's
  // relative-cursor redraw math desyncs against xterm.js's own scrolling —
  // each frame then lands one row lower than the last instead of
  // overwriting in place (confirmed via a real VT100 emulator, not
  // guessed). Frame height = FixedHeight(30) + 2 border + 3 status block +
  // 2 bezel edges = 37 (see signal_loss/pkg/tui/styles.go). Keep in sync
  // if that ever changes.
  const COLS = 84;
  const ROWS = 37;
  const SAVE_KEY = "signal_loss_save";
  const STATS_KEY = "signal_loss_stats"; // shared by both languages: endings are keyed by id

  const widget = document.getElementById("game-widget")!;
  // Matches astro.config.mjs's `base` — read off the DOM instead of
  // hardcoding it here, since this script has no access to Astro's
  // frontmatter/build-time env directly.
  const BASE = widget.dataset.base || "/";
  const T = JSON.parse(widget.dataset.t!);

  const statusEl = document.getElementById("game-status")!;
  const terminalEl = document.getElementById("terminal")!;
  const termBox = terminalEl.parentElement!; // the bordered/overflow box
  const launchPanel = document.getElementById("launch-panel")!;
  const launchBtn = document.getElementById("launch-btn")!;
  const modeHint = document.getElementById("mode-hint")!;
  const exitPanel = document.getElementById("exit-panel")!;
  const exitQuote = document.getElementById("exit-quote")!;
  const reconnectBtn = document.getElementById("reconnect-btn")!;

  const store = {
    get: (k: string) => { try { return localStorage.getItem(k) || ""; } catch { return ""; } },
    set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* private mode: the run just won't persist */ } },
  };

  reconnectBtn.addEventListener("click", () => window.location.reload());

  // Guards against booting a second game engine into the same DOM node —
  // e.g. a dev-mode HMR update re-running this module without a full page
  // reload would otherwise spin up a second Bubble Tea program racing the
  // first one to write into the same terminal, which looks like the whole
  // screen "doubling up".
  if (terminalEl.dataset.booted === "true") {
    throw new Error("signal_loss terminal already booted for this element — skipping re-init");
  }
  terminalEl.dataset.booted = "true";

  // xterm.js translates mouse-wheel scrolling into arrow-key escape
  // sequences whenever a focused terminal is on the alt-screen buffer
  // (standard terminal emulator behavior, for curses-style apps that want
  // to handle scrolling themselves) — Bubble Tea then reads those as real
  // keypresses, which advanced the boot prompt just from scrolling past
  // it. We don't want that: capture wheel events before xterm sees them
  // and just scroll the page instead.
  termBox.addEventListener(
    "wheel",
    (e) => {
      if (Math.abs(e.deltaY) >= Math.abs(e.deltaX)) {
        e.preventDefault();
        e.stopPropagation();
        window.scrollBy(0, e.deltaY);
      }
      // otherwise: mostly-horizontal gesture, let the box's own
      // overflow-x-auto scroll natively (narrow-screen terminal panning).
    },
    { passive: false, capture: true },
  );

  const term = new Terminal({
    cols: COLS,
    rows: ROWS,
    // convertEol must stay OFF: it force-rewrites every \n to \r\n, which
    // corrupts Bubble Tea's own cursor math (it manages \r/\n itself, the
    // same way it would over a real raw-mode pty — no implicit LF-to-CRLF
    // translation there either). With it on, each typewriter-reveal frame
    // landed one row below the last instead of overwriting it in place.
    disableStdin: false,
    cursorBlink: true,
    fontFamily: "ui-monospace, SF Mono, Cascadia Code, JetBrains Mono, Menlo, Consolas, monospace",
    fontSize: 14,
    theme: {
      background: "#000000",
      foreground: "#d1d5db",
    },
  });
  term.open(terminalEl);

  declare global {
    interface Window {
      Go: any;
      slStart: (
        storyJSON: string,
        savedJSON: string,
        fast: boolean,
        realtime: boolean,
        lang: string,
        onOutput: (out: string) => void,
        onSave: (json: string) => void,
        onExit: () => void,
        statsJSON: string,
        onStats: (json: string) => void,
      ) => void;
      slInput: (data: string) => void;
    }
  }

  // --- launch panel wiring -------------------------------------------

  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const selection: Record<string, string> = { lang: widget.dataset.lang || "en", speed: reducedMotion ? "fast" : "normal", mode: "compressed" };

  const press = (group: Element, value: string) =>
    group.querySelectorAll<HTMLButtonElement>(".config-btn").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.value === value)));

  document.querySelectorAll<HTMLElement>("#launch-panel [data-group]").forEach((group) => {
    const key = group.dataset.group!;
    press(group, selection[key]);
    group.querySelectorAll<HTMLButtonElement>(".config-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        selection[key] = btn.dataset.value!;
        press(group, selection[key]);
        if (key === "mode") {
          modeHint.textContent = btn.dataset.value === "realtime" ? T.hintRealtime : T.hintCompressed;
        }
      });
    });
  });

  launchBtn.addEventListener("click", () => {
    launchPanel.remove();
    boot(selection.lang, selection.speed === "fast", selection.mode === "realtime").catch(onBootError);
  });

  // Save import (from the terminal version, or another browser) and export.
  // Saves are per language — item names differ — so a save lands in the language chosen above.
  const importMsg = document.getElementById("import-msg")!;
  document.getElementById("import-file")!.addEventListener("change", async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    try {
      const text = await file.text();
      const s = JSON.parse(text);
      if (typeof s.current_chapter !== "string" || typeof s.hull !== "number") throw new Error("not a save");
      store.set(`${SAVE_KEY}_${selection.lang}`, text);
      importMsg.textContent = T.importDone;
    } catch {
      importMsg.textContent = T.importBad;
    }
  });

  let playingLang = selection.lang;
  document.getElementById("export-btn")!.addEventListener("click", () => {
    const text = store.get(`${SAVE_KEY}_${playingLang}`);
    if (!text) {
      statusEl.textContent = T.noSave;
      return;
    }
    const a = document.createElement("a");
    a.href = URL.createObjectURL(new Blob([text], { type: "application/json" }));
    a.download = `signal_loss_save_${playingLang}.json`;
    a.click();
    URL.revokeObjectURL(a.href);
  });

  // --- touch keys ------------------------------------------------------

  document.querySelectorAll<HTMLButtonElement>("#touchpad [data-send]").forEach((b) =>
    b.addEventListener("click", () => window.slInput?.(b.dataset.send!)),
  );

  // --- sound (off until asked for; nothing is downloaded, it is all synthesized) ---

  let audio: AudioContext | null = null;
  let soundOn = store.get("sl_sound") === "1";
  const soundBtn = document.getElementById("sound-btn")!;
  const showSound = () => {
    soundBtn.textContent = soundOn ? T.soundOn : T.soundOff;
    soundBtn.setAttribute("aria-pressed", String(soundOn));
  };
  showSound();
  soundBtn.addEventListener("click", () => {
    soundOn = !soundOn;
    store.set("sl_sound", soundOn ? "1" : "0");
    showSound();
    if (soundOn) beep(660, 0.08, "square", 0.05);
  });
  function beep(freq: number, dur: number, type: OscillatorType = "square", gain = 0.03, delay = 0) {
    if (!soundOn || reducedMotion && dur > 0.2) return;
    audio ??= new AudioContext();
    const t0 = audio.currentTime + delay;
    const osc = audio.createOscillator();
    const g = audio.createGain();
    osc.type = type;
    osc.frequency.value = freq;
    g.gain.setValueAtTime(gain, t0);
    g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
    osc.connect(g).connect(audio.destination);
    osc.start(t0);
    osc.stop(t0 + dur);
  }

  // --- end of a run: stats and the share text --------------------------

  let stats = (() => { try { return JSON.parse(store.get(STATS_KEY) || "{}"); } catch { return {}; } })();

  function onStats(json: string) {
    const prev = stats;
    stats = JSON.parse(json);
    store.set(STATS_KEY, json);
    let text: string;
    if ((stats.deaths || 0) > (prev.deaths || 0)) {
      text = T.died.replace("{n}", String(stats.deaths));
      [220, 165, 110].forEach((f, i) => beep(f, 0.25, "sawtooth", 0.05, i * 0.22));
    } else {
      const id = Object.keys(stats.endings || {}).find((k) => stats.endings[k] > ((prev.endings || {})[k] || 0)) || "";
      text = T.escaped.replace("{title}", T.endings[id] || id);
      [523, 659, 784, 1047].forEach((f, i) => beep(f, 0.2, "triangle", 0.05, i * 0.12));
    }
    document.getElementById("share-text")!.textContent = text;
    const share = document.getElementById("share")!;
    share.classList.remove("hidden");
    share.classList.add("flex");
  }

  const shareBtn = document.getElementById("share-btn")!;
  shareBtn.addEventListener("click", async () => {
    const text = `${document.getElementById("share-text")!.textContent} ${location.origin}${BASE}`;
    try { await navigator.clipboard.writeText(text); shareBtn.textContent = T.shareCopied; } catch { window.prompt("", text); }
  });

  // ---------------------------------------------------------------------

  async function boot(lang: string, fast: boolean, realtime: boolean) {
    statusEl.textContent = T.status.connecting;
    playingLang = lang;

    const go = new window.Go();

    const wasmResp = await fetch(`${BASE}game/game.wasm`);
    const { instance } = await WebAssembly.instantiate(await wasmResp.arrayBuffer(), go.importObject);
    go.run(instance);

    const storyFile = lang === "de" ? "story_de.json" : "story.json";
    const storyText = await (await fetch(`${BASE}game/${storyFile}`)).text();
    // Namespaced per language: a German-run save's item names ("Hyperkondensator")
    // wouldn't match English story data's items_removed lookups ("Hyper-Capacitor"),
    // so switching languages starts a fresh run instead of corrupting inventory state.
    const saveKey = `${SAVE_KEY}_${lang}`;
    const saved = store.get(saveKey);

    term.onData((data) => {
      window.slInput(data);
      if (data.length === 1 || data.startsWith("\x1b")) beep(1200, 0.02, "square", 0.015);
    });

    window.slStart(
      storyText,
      saved,
      fast,
      realtime,
      lang,
      (out) => term.write(out),
      (json) => store.set(saveKey, json),
      onExit,
      JSON.stringify(stats),
      onStats,
    );

    statusEl.textContent = T.status.live;
    statusEl.classList.remove("text-amber");
    statusEl.classList.add("text-green");
    term.focus();
  }

  // Fires when the Bubble Tea program itself exits — currently only via
  // [q]uit in-game, but covers any other exit path too. The terminal is
  // left as-is behind the panel (Bubble Tea already restores the main
  // screen on its way out, so there's nothing worth showing there).
  function onExit() {
    statusEl.textContent = T.status.offline;
    statusEl.classList.remove("text-green");
    statusEl.classList.add("text-dim");
    exitQuote.textContent = T.quotes[Math.floor(Math.random() * T.quotes.length)];
    exitPanel.classList.remove("hidden");
    exitPanel.classList.add("flex");
  }

  function onBootError(err: unknown) {
    statusEl.textContent = T.status.lost;
    statusEl.classList.remove("text-amber");
    statusEl.classList.add("text-red");
    console.error(err);
    term.write(`\r\n${T.bootError}\r\n`);
  }
</script>
